{
  "name": "duckymovie",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "Un editor video semplice e locale per Windows",
  "author": "DuckyMovie",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "tsx tests/ui-smoke.ts",
    "package": "node scripts/check-engine.mjs && npm run build && electron-builder --win zip",
    "package:installer": "node scripts/check-engine.mjs && npm run build && electron-builder --win nsis --x64 --publish never --config.directories.output=release/installers",
    "package:dir": "node scripts/check-engine.mjs && npm run build && electron-builder --win dir",
    "build:engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-engine.ps1",
    "test:advanced-ui": "tsx tests/advanced-ui.ts",
    "test:workflows": "tsx tests/remediation-ui.ts",
    "test:editing-ui": "tsx tests/editing-ui.ts",
    "test:library-ui": "tsx tests/library-workflows-ui.ts",
    "test:timeline-ui": "tsx tests/timeline-ui.ts",
    "test:selection-ui": "tsx tests/selection-ui.ts",
    "test:media-removal-ui": "tsx tests/media-removal-ui.ts"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.8"
  },
  "overrides": {
    "minimatch": "11.0.8"
  },
  "build": {
    "appId": "it.duckymovie.app",
    "productName": "DuckyMovie",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release/0.6.1"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/ffprobe-static/bin/darwin/**/*",
      "!node_modules/ffprobe-static/bin/linux/**/*",
      "!node_modules/ffprobe-static/bin/win32/ia32/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "win": {
      "target": "zip",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "artifactName": "DuckyMovie-Setup-${version}-Windows-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DuckyMovie",
      "installerLanguages": ["it_IT", "en_US"],
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "DuckyMovie-${version}-Windows-${arch}.${ext}",
    "extraResources": [
      {
        "filter": [
          "**/*"
        ],
        "from": "engine-dist/DuckyMovieEngine",
        "to": "engine"
      }
    ]
  }
}
